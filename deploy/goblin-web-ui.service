[Unit]
Description=GoblinMetrics web UI
After=network.target

[Service]
Type=simple
User=goblin-metrics
Group=goblin-metrics
Environment=DB_PATH=/var/lib/goblin-metrics/metrics.db
Environment=BIND_ADDR=0.0.0.0:4444
Environment=RUST_LOG=web_ui=info
ExecStart=/opt/goblin-metrics/web-ui
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
